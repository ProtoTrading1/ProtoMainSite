{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/ensure-preregister-banner.mjs && vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/register",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pre-register",
      "has": [
        {
          "type": "host",
          "value": "register.proto.co.za"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pre-register",
      "has": [
        {
          "type": "host",
          "value": "www.register.proto.co.za"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://fonts.googleapis.com; frame-src 'self'; media-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/send-order.js": {
      "includeFiles": "node_modules/pdfkit/js/data/*.afm",
      "maxDuration": 60
    }
  }
}
