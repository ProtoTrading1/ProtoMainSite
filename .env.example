# ── Supabase (main project: auth, customers, orders) ─────────────────────────
# VITE_-prefixed vars are bundled into the client — only safe public keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase (stock project: website_stock, archived_products) ───────────────
# NOTE: this key is privileged (service-role) — it bypasses RLS so the login-gated
# admin can write the catalogue directly. Public read is also allowed via RLS.
VITE_STOCK_SUPABASE_URL=https://your-stock-project.supabase.co
VITE_STOCK_SUPABASE_KEY=your-stock-service-role-key

# ── Brevo transactional email (server-only) ──────────────────────────────────
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_NAME=Proto Trading Online
# Sender domain must be verified in Brevo (Senders & Domains) or sends will fail.
BREVO_SENDER_EMAIL=online@proto.co.za
# Where order/product-request emails are delivered.
ORDER_TO_EMAIL=orders@prototrading.co.za

# ── Site ──────────────────────────────────────────────────────────────────────
# Used to build password-reset links and trade-portal redirects from the sign-up domain.
SITE_URL=https://protoportal-main.vercel.app

# Public trade portal URL (catalogue + ordering). Sign-up domain sends approved users here.
VITE_PORTAL_URL=https://protoportal-main.vercel.app

# Optional: force pre-register-only mode in local dev (otherwise hostname must match).
# VITE_PREREGISTER_MODE=true

# Optional: extra hostnames that serve registration only (comma-separated).
# Default includes site.proto.co.za and www.site.proto.co.za
# VITE_PREREGISTER_HOSTS=site.proto.co.za,www.site.proto.co.za
