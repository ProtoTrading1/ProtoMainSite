# ── Supabase (main project: auth, customers, orders) ─────────────────────────
# VITE_-prefixed vars are bundled into the client — only safe public keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase (stock project: website_stock, archived_products) ───────────────
# NOTE: this key is privileged (service-role) — it bypasses RLS so the login-gated
# admin can write the catalogue directly. Public read is also allowed via RLS.
VITE_STOCK_SUPABASE_URL=https://your-stock-project.supabase.co
VITE_STOCK_SUPABASE_KEY=your-stock-service-role-key

# ── Brevo transactional email (server-only) ──────────────────────────────────
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_NAME=Proto Trading Online
# Sender domain must be verified in Brevo (Senders & Domains) or sends will fail.
BREVO_SENDER_EMAIL=online@proto.co.za
# Where order/product-request emails are delivered.
ORDER_TO_EMAIL=orders@prototrading.co.za

# ── Error monitoring (optional) ───────────────────────────────────────────────
# Create a free project at sentry.io, then paste its DSN here. Leave unset to
# disable monitoring entirely (errors just log to console, no bundle cost).
# VITE_SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxx

# ── Site ──────────────────────────────────────────────────────────────────────
# Main trade portal (landing page + catalogue + ordering).
SITE_URL=https://site.proto.co.za
VITE_PORTAL_URL=https://site.proto.co.za

# Host used for LINKS inside outgoing email. Defaults to https://proto.co.za in
# code — leave this UNSET unless the portal moves again. It is deliberately not
# SITE_URL: that still points at the host serving the app, and emailed links
# must land on the domain Proto is migrating to.
# EMAIL_LINK_URL=https://proto.co.za

# Host serving images inside outgoing email (logos). Falls back to SITE_URL.
# Set this to https://proto.co.za once that domain serves /proto-logo.png and
# /proto-trading-online-email.png.
# EMAIL_ASSET_URL=https://site.proto.co.za

# Trade registration-only subdomain (add register.proto.co.za in Vercel + DNS).
# Default hosts: register.proto.co.za, www.register.proto.co.za
# VITE_PREREGISTER_MODE=true
# VITE_PREREGISTER_HOSTS=register.proto.co.za
